# Publish only course materials and repository instructions.
/*
!/Material/
!/README.md
!/.gitignore
!/index.html
!/courses.js
!/site.js
!/.nojekyll
!/THIRD_PARTY_NOTICES.txt

# Released weeks: add one line per week when it is ready for publication.
/Material/*
!/Material/Week01/
!/Material/Week02/
!/Material/Week03/
!/Material/Week04/
!/Material/Week05/
!/Material/Week06/

# Inside each released week, publish only the standard files; drafts stay local.
/Material/Week*/*
!/Material/Week*/index.html
!/Material/Week*/slides.pdf
!/Material/Week*/transcript.md
!/Material/Week*/transcript-raw.*
!/Material/Week*/transcript-visual.html
!/Material/Week*/assets/

# Week 3 images are embedded; only these source downloads are public.
/Material/Week03/assets/
!/Material/Week03/transcript-timed.json

# Week 4: exactly five publication files; embedded images and local drafts stay excluded.
/Material/Week04/*
!/Material/Week04/index.html
!/Material/Week04/slides.pdf
!/Material/Week04/transcript.md
!/Material/Week04/transcript-raw.md
!/Material/Week04/transcript-timed.json

# Week 5: exactly five publication files; original PDF, images and working sources stay local.
/Material/Week05/*
!/Material/Week05/index.html
!/Material/Week05/slides.pdf
!/Material/Week05/transcript.md
!/Material/Week05/transcript-raw.md
!/Material/Week05/transcript-timed.json

# Week 6: exactly five publication files; source media, images and working notes stay local.
/Material/Week06/*
!/Material/Week06/index.html
!/Material/Week06/slides.pdf
!/Material/Week06/transcript.md
!/Material/Week06/transcript-raw.md
!/Material/Week06/transcript-timed.json

# macOS metadata and Office temporary files.
.DS_Store
~$*
